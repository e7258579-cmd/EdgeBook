rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Trading system (read-only for the owner; the backend writes with the Admin SDK) ──
    function isOwner() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'eyal.krn@gmail.com';
    }
    match /signals/{id}    { allow read: if isOwner(); }
    match /positions/{id}  { allow read: if isOwner(); }
    match /orders/{id}     { allow read: if isOwner(); }
    match /trades/{id}     { allow read: if isOwner(); }
    match /stats/{id}      { allow read: if isOwner(); }
    match /alerts/{id}     { allow read: if isOwner(); }
    match /heartbeats/{id} { allow read: if isOwner(); }
    match /control/{id}    { allow read: if isOwner(); }

    // ── Journal app (unchanged) ──
    // New structure: per-trade documents
    match /users/{userId}/trades/{tradeId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
    // Journal v2: per-entry documents (day / week / month / year reflections + AI summaries)
    match /users/{userId}/journalV2/{entryId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
    // Meta: internal app bookkeeping docs (e.g. migration status flag)
    match /users/{userId}/meta/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
    // Legacy structure: keep readable during migration window,
    // then remove after all users have migrated.
    match /users/{userId}/accounts/{accountId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow write: if false;  // block new writes to old path
    }
  }
}
